# JobStock root rewrite for Apache/XAMPP subfolder hosting.
# Project URL example: http://127.0.0.1/laravel/job-portal/
# Keep Laravel's public/.htaccess in place as well.
<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Preserve Authorization header for Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve public assets from the project-root URL without exposing /public.
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
    RewriteRule ^build/(.*)$ public/build/$1 [L,NC]
    RewriteRule ^storage/(.*)$ public/storage/$1 [L,NC]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L,NC]

    # Keep hidden files and Laravel internals inaccessible over HTTP.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js)$ - [F,L,NC]

    # Send application routes to Laravel's public front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
