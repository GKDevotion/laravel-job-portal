# Add these values to your existing .env to create a first administrator.
JOBSTOCK_SUPER_ADMIN_NAME="JobStock Super Admin"
JOBSTOCK_SUPER_ADMIN_EMAIL=admin@example.com
JOBSTOCK_SUPER_ADMIN_PASSWORD=ChangeThisToAStrongUniquePassword

# Configure SMTP before enabling production email verification and password resets.
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="JobStock"
